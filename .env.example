# Токен от @BotFather (старый токен засвечен в репозитории, выпусти новый!)
BOT_TOKEN=
# Твой Telegram ID (узнать: @userinfobot). Несколько через запятую.
ADMIN_IDS=
# Ссылка на платформу с бесплатным курсом
COURSE_URL=
# file_id видео: отправь видео боту с админского аккаунта, он пришлёт file_id
VIDEO_FILE_ID=
# Или просто ссылка на видео (YouTube, Rutube), если file_id нет
VIDEO_URL=
# Где хранить базу. На хостинге укажи путь на постоянном диске, например /data/bot.db
DB_PATH=bot.db
